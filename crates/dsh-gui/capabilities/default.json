{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "dsh-gui main window: frameless titlebar needs the custom minimize / maximize / close controls and drag-region handling",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": [
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "clipboard:allow-write-text",
    "allow-startup-interactive",
    "allow-show-desktop-notification"
  ]
}
