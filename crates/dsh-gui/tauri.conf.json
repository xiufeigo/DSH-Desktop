{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Desktop",
  "version": "0.1.1-rc.2.1",
  "identifier": "ai.deepseek.dsh-desktop",
  "build": {
    "frontendDist": "loading"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "DSH Desktop contributors",
    "shortDescription": "第三方开发的 DeepSeek Harness 桌面版（Tauri + WebView2）",
    "license": "../../LICENSE",
    "icon": ["icons/icon.ico"],
    "resources": ["payload/**/*"],
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "customLanguageFiles": {
          "SimpChinese": "languages/SimpChinese.nsh",
          "English": "languages/English.nsh"
        },
        "template": "installer.nsi",
        "installMode": "currentUser",
        "installerHooks": "installer.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "startMenuFolder": "DSH Desktop"
      }
    }
  }
}
