+/**
+ * Settled renders are a pure function of (text, labels, fileMentions,
+ * pathImages), but they re-parse the entire reply (GFM + KaTeX) whenever a
+ * finished message remounts — switching back to a long session re-renders
+ * every message and pays that cost for all of them at once. Memoize the last
+ * N settled results as an LRU keyed by the exact inputs; a hit skips parse
+ * and render entirely. Cached elements remain safe to share across messages
+ * because an equal key implies identical inputs, so handlers baked into those
+ * elements observe exactly what their original render observed.
+ *
+ * The object-valued inputs are keyed by identity rather than by serialized
+ * value: `fileMentions` and `pathImages` each carry a `resolve` function that
+ * JSON.stringify drops, which would collapse every resolver to one key and let
+ * a message reuse another's mention or image handlers. `labels` is
+ * reference-stable per locale revision by contract (see MarkdownText), so
+ * identity is exact there too.
+ */
+const SETTLED_CACHE_LIMIT = 40
+
+/** Monotonic ids standing in for the object-valued render inputs' identities. */
+const settledInputIds = new WeakMap<object, number>()
+let settledInputSeq = 0
+
+function settledInputId(value: object | undefined): number {
+  if (value === undefined) return 0
+  const known = settledInputIds.get(value)
+  if (known !== undefined) return known
+  settledInputSeq += 1
+  settledInputIds.set(value, settledInputSeq)
+  return settledInputSeq
+}
+
+const settledCache = new Map<string, ReactNode[]>()
+
+/** Last-N LRU memoization over {@link renderSettled}, keyed by its inputs. */
+function renderSettledCached(
+  text: string,
+  labels: MarkdownLabels,
+  fileMentions: MarkdownFileMentions | undefined,
+  pathImages: MarkdownPathImages | undefined,
+): ReactNode[] {
+  const key = `${String(settledInputId(labels))}|${String(settledInputId(fileMentions))}|${String(settledInputId(pathImages))}|${text}`
+  const fresh = settledCache.get(key)
+  if (fresh !== undefined) {
+    settledCache.delete(key)
+    settledCache.set(key, fresh)
+    return fresh
+  }
+  const children = renderSettled(text, labels, fileMentions, pathImages)
+  if (settledCache.size >= SETTLED_CACHE_LIMIT) {
+    for (const oldest of settledCache.keys()) {
+      settledCache.delete(oldest)
+      break
+    }
+  }
+  settledCache.set(key, children)
+  return children
+}
