+/**
+ * Settled renders are a pure function of (text, labels, fileMentions),
+ * but they re-parse the entire reply (GFM + KaTeX) whenever a finished
+ * message remounts — switching back to a long session re-renders every
+ * message and pays that cost for all of them at once. Memoize the last N
+ * settled results as an LRU keyed by the exact inputs; a hit skips parse
+ * and render entirely. Cached elements remain safe to share across
+ * messages because an equal key implies identical inputs, so handlers
+ * baked into those elements observe exactly what their original render
+ * observed.
+ */
+const SETTLED_CACHE_LIMIT = 40
+
+const settledCache = new Map<string, ReactNode[]>()
+
+/** Last-N LRU memoization over {@link renderSettled}, keyed by its inputs. */
+function renderSettledCached(
+  text: string,
+  labels: MarkdownLabels,
+  fileMentions: MarkdownFileMentions | undefined,
+): ReactNode[] {
+  const key = JSON.stringify([text, labels, fileMentions])
+  const fresh = settledCache.get(key)
+  if (fresh !== undefined) {
+    settledCache.delete(key)
+    settledCache.set(key, fresh)
+    return fresh
+  }
+  const children = renderSettled(text, labels, fileMentions)
+  if (settledCache.size >= SETTLED_CACHE_LIMIT) {
+    for (const oldest of settledCache.keys()) {
+      settledCache.delete(oldest)
+      break
+    }
+  }
+  settledCache.set(key, children)
+  return children
+}
